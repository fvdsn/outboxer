# Copy to .env; the justfile loads it automatically (set dotenv-load).
# Every variable is optional and falls back to the default shown.

# Local integration tests (just integration / just e2e)
#INTEGRATION_PG_DSN=postgres://outboxer:outboxer@localhost:54329/outboxer?sslmode=disable

# Image tag used by just docker-build and the cloud deployments
#IMAGE=outboxer:local

# Cloud test deployments (just cloud-gcp-* / just cloud-aws-*)
#OUTBOXER_GCP_PROJECT=
#OUTBOXER_GCP_REGION=europe-west1
#OUTBOXER_AWS_REGION=eu-central-1
